generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id
  email        String?
  displayName  String    @map("display_name")
  username     String
  bio          String?
  avatarUrl    String?   @map("avatar_url")
  authProvider String?   @default("apple") @map("auth_provider")
  isPremium    Boolean   @default(false) @map("is_premium")
  city         String?
  country      String?
  countryCode  String?   @map("country_code")
  createdAt    DateTime? @default(now()) @map("created_at")

  @@map("users")
}

model Friend {
  id                String    @id
  displayName       String    @map("display_name")
  username          String
  avatarUrl         String?   @map("avatar_url")
  isMutual          Boolean   @default(true) @map("is_mutual")
  mutualMoviesCount Int       @default(0) @map("mutual_movies_count")
  createdAt         DateTime? @default(now()) @map("created_at")

  @@map("friends")
}

model Review {
  id               String          @id
  movieId          String          @map("movie_id")
  movieTitle       String          @map("movie_title")
  moviePosterUrl   String?         @map("movie_poster_url")
  movieReleaseYear Int?            @map("movie_release_year")
  userId           String          @map("user_id")
  userName         String          @map("user_name")
  userAvatarUrl    String?         @map("user_avatar_url")
  rating           Decimal         @db.Decimal(3, 1)
  comment          String?
  likesCount       Int             @default(0) @map("likes_count")
  helpfulCount     Int             @default(0) @map("helpful_count")
  isCommunity      Boolean         @default(false) @map("is_community")
  createdAt        DateTime?       @default(now()) @map("created_at")
  updatedAt        DateTime?       @map("updated_at")
  comments         ReviewComment[]

  @@map("reviews")
}

model ReviewComment {
  id            String    @id
  reviewId      String    @map("review_id")
  userId        String    @map("user_id")
  userName      String    @map("user_name")
  userAvatarUrl String?   @map("user_avatar_url")
  text          String
  createdAt     DateTime? @default(now()) @map("created_at")
  review        Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_comments")
}

model MovieGroup {
  id            String         @id
  name          String
  description   String?
  iconEmoji     String?        @default("🎬") @map("icon_emoji")
  creatorId     String         @map("creator_id")
  creatorName   String         @map("creator_name")
  inviteCode    String?        @unique @map("invite_code")
  messagesCount Int            @default(0) @map("messages_count")
  createdAt     DateTime?      @default(now()) @map("created_at")
  messages      GroupMessage[]

  @@map("movie_groups")
}

model GroupMessage {
  id               String     @id
  groupId          String     @map("group_id")
  userId           String     @map("user_id")
  userName         String     @map("user_name")
  text             String
  messageType      String?    @default("text") @map("message_type")
  sharedMovieId    String?    @map("shared_movie_id")
  sharedMovieTitle String?    @map("shared_movie_title")
  createdAt        DateTime?  @default(now()) @map("created_at")
  group            MovieGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("group_messages")
}

model DirectConversation {
  id            String          @id
  participantId String          @map("participant_id")
  unreadCount   Int             @default(0) @map("unread_count")
  updatedAt     DateTime?       @default(now()) @map("updated_at")
  messages      DirectMessage[]

  @@map("direct_conversations")
}

model DirectMessage {
  id               String             @id
  conversationId   String             @map("conversation_id")
  senderId         String             @map("sender_id")
  senderName       String             @map("sender_name")
  senderAvatarUrl  String?            @map("sender_avatar_url")
  recipientId      String             @map("recipient_id")
  text             String
  messageType      String?            @default("text") @map("message_type")
  sharedMovieId    String?            @map("shared_movie_id")
  sharedMovieTitle String?            @map("shared_movie_title")
  createdAt        DateTime?          @default(now()) @map("created_at")
  conversation     DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("direct_messages")
}

model TheatricalMovie {
  id                String           @id
  title             String
  synopsis          String?
  posterUrl         String?          @map("poster_url")
  releaseDate       DateTime?        @map("release_date")
  originCountry     String?          @map("origin_country")
  originCountryName String?          @map("origin_country_name")
  genres            String?
  director          String?
  compositeScore    Decimal?         @default(8.0) @map("composite_score") @db.Decimal(3, 1)
  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime?        @default(now()) @map("created_at")
  showtimes         CinemaShowtime[]

  @@map("theatrical_movies")
}

model CinemaShowtime {
  id          String          @id
  movieId     String          @map("movie_id")
  cinemaName  String          @map("cinema_name")
  city        String
  countryCode String          @map("country_code")
  roomFormat  String          @map("room_format")
  times       String[]        @default([])
  createdAt   DateTime?       @default(now()) @map("created_at")
  movie       TheatricalMovie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@map("cinema_showtimes")
}

