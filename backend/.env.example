# Formato de Neon PostgreSQL (con sslmode=require)
DATABASE_URL=postgresql://usuario:password@ep-ejemplo-123456.us-east-2.aws.neon.tech/moviesocial?sslmode=require

# Puerto del servidor API REST (8080 para local, Render/Koyeb asignan su propio PORT)
PORT=8080
HOST=0.0.0.0
